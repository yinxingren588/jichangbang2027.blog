---
import type { AirportItem } from '../data/airports';

export interface Props {
  airport: AirportItem;
}

const { airport } = Astro.props;

const categoryColors: Record<string, string> = {
  '专线旗舰': 'background: #f5f3ff; color: #6d28d9; border: 1px solid #ddd6fe;',
  '低延迟电竞': 'background: #fffbeb; color: #b45309; border: 1px solid #fde68a;',
  'AI原生住宅': 'background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;',
  '高性价比': 'background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;',
  '平价轻量': 'background: #f8fafc; color: #475569; border: 1px solid #cbd5e1;',
};
---

<article class="airport-card" id={`airport-${airport.id}`} data-category={airport.categoryTag}>
  <div class="card-top">
    <div class={`card-rank-badge ${airport.rank === 1 ? 'rank-1' : airport.rank === 2 ? 'rank-2' : airport.rank === 3 ? 'rank-3' : 'rank-normal'}`}>
      #{airport.rank}
    </div>
    <div class="card-name-group">
      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <h3 class="card-title">{airport.name}</h3>
        <span class="brand-badge" style={categoryColors[airport.categoryTag] || ''}>
          {airport.categoryTag}
        </span>
      </div>
      {airport.badge && (
        <span style="display: inline-block; font-size: 0.75rem; color: #0284c7; font-weight: 600; margin-top: 0.15rem;">
          {airport.badge}
        </span>
      )}
    </div>
    <div class="card-score">
      <div class="score-num">{airport.score}</div>
      <div class="score-label">综合得分</div>
    </div>
  </div>

  <p class="card-tagline">{airport.tagline}</p>

  <!-- Real Performance Telemetry Metrics -->
  <div style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.5rem 0.75rem; margin: 0.65rem 0; display: flex; justify-content: space-between; font-size: 0.8rem;">
    <div>
      <span style="color: var(--text-muted); font-size: 0.72rem; display: block;">单节点峰值</span>
      <span style="color: #0284c7; font-weight: 700;">⚡ {airport.peakSpeed}</span>
    </div>
    <div>
      <span style="color: var(--text-muted); font-size: 0.72rem; display: block;">亚太延迟</span>
      <span style="color: #059669; font-weight: 700;">📶 {airport.latency}</span>
    </div>
    <div>
      <span style="color: var(--text-muted); font-size: 0.72rem; display: block;">SLA在线率</span>
      <span style="color: #d97706; font-weight: 700;">🛡️ {airport.stabilityRate}</span>
    </div>
  </div>

  <div class="card-features">
    {airport.tags.map((tag, idx) => (
      <span class={`feature-pill ${idx === 0 ? 'highlight' : ''}`}>{tag}</span>
    ))}
  </div>

  <div class="card-specs">
    <div class="spec-item">
      <span class="spec-label">专线架构</span>
      <span class="spec-value" style="font-size: 0.8rem;">{airport.lineType}</span>
    </div>
    <div class="spec-item">
      <span class="spec-label">全系流量档位</span>
      <span class="spec-value" style="font-size: 0.8rem;">{airport.traffic}</span>
    </div>
    <div class="spec-item">
      <span class="spec-label">流媒体/AI支持</span>
      <span class="spec-value" style="color: #059669; font-size: 0.8rem;">Netflix 4K / ChatGPT / TikTok</span>
    </div>
    <div class="spec-item">
      <span class="spec-label">客户端兼容</span>
      <span class="spec-value" style="font-size: 0.8rem;">Clash / Sing-box / 小火箭</span>
    </div>
  </div>

  <!-- Key Core Advantages -->
  <ul style="list-style: none; padding: 0; margin: 0 0 0.85rem; display: grid; gap: 0.3rem; font-size: 0.79rem; color: #334155; line-height: 1.45;">
    {airport.features.slice(0, 3).map((feat) => (
      <li style="display: flex; align-items: flex-start; gap: 0.35rem;">
        <span style="color: #059669; font-weight: 800;">✓</span>
        <span>{feat}</span>
      </li>
    ))}
  </ul>

  <!-- Coupon Banner inside Card -->
  {airport.couponCode ? (
    <div style="background: #fffbeb; border: 1px dashed #f59e0b; border-radius: var(--radius-sm); padding: 0.4rem 0.65rem; margin-bottom: 0.85rem; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
      <span style="font-size: 0.76rem; color: #92400e; font-weight: 600;">
        🎟️ 券：<code style="background: #fef3c7; color: #b45309; padding: 0.1rem 0.35rem; border-radius: 3px; font-weight: 800;">{airport.couponCode}</code>
      </span>
      <button
        type="button"
        data-copy-coupon={airport.couponCode}
        style="background: #f59e0b; color: #ffffff; border: none; border-radius: 4px; padding: 0.2rem 0.55rem; font-size: 0.72rem; font-weight: 700; cursor: pointer;"
      >
        点击复制
      </button>
    </div>
  ) : (
    <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: var(--radius-sm); padding: 0.4rem 0.65rem; margin-bottom: 0.85rem; font-size: 0.75rem; color: #475569;">
      💡 {airport.yearlyNote || airport.couponDesc}
    </div>
  )}

  <div class="card-footer">
    <div class="price-box">
      <span class="price-sub">{airport.startQuota}</span>
      <div>
        <span class="price-main">{airport.price}</span>
        <span class="price-unit">{airport.billingCycle}</span>
      </div>
    </div>

    <div class="card-actions">
      <a href={airport.reviewUrl} class="btn-secondary" title={`${airport.name}全部${airport.plans.length}档套餐与评测`} style="padding: 0.45rem 0.65rem; font-size: 0.78rem; font-weight: 600;">
        {airport.plans.length}档套餐
      </a>
      <a href={airport.buyUrl} class="btn-primary" target="_blank" rel="noopener nofollow" title={`前往${airport.name}官网`} style="padding: 0.45rem 0.85rem; font-size: 0.82rem;">
        直达官网 🚀
      </a>
    </div>
  </div>
</article>
