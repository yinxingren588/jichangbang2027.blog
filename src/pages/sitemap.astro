---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { AIRPORT_LIST } from '../data/airports';
import { FAQS_DATA, FAQ_CATEGORIES } from '../data/faqs';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '网站地图 (Sitemap)', url: '/sitemap' }
];

const totalUrls = 8 + AIRPORT_LIST.length + sortedPosts.length + FAQS_DATA.length;
---

<BaseLayout
  title="网站地图 (HTML Sitemap) - 2027机场榜全站导航索引"
  description={`2027机场榜（jichangbang2027.blog）全站内容索引地图：涵盖全部${AIRPORT_LIST.length}家精选机场独立套餐评测页、${sortedPosts.length}篇深度博客专栏、${FAQS_DATA.length}篇独立排错FAQ指南与官方XML Sitemap索引入口。`}
  keywords={['2027机场榜网站地图', 'jichangbang2027 sitemap', '机场评测全站导航', '科学上网知识库目录']}
  canonicalUrl="https://jichangbang2027.blog/sitemap"
>
  <div class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
    <Breadcrumb items={breadcrumbs} />

    <header style="margin-bottom: 2.5rem; text-align: center;">
      <div class="hero-pill">🗺️ 全站 HTML 网站地图 · 共收录 {totalUrls} 个核心页面与档案</div>
      <h1 class="hero-title" style="font-size: 2.3rem;">
        2027机场榜：全站内容索引与网站地图 (Sitemap)
      </h1>
      <p class="hero-desc" style="max-width: 780px;">
        方便用户与搜索引擎（Bingbot / Googlebot / Baiduspider）一键直达本站全部频道、{AIRPORT_LIST.length} 家品牌套餐详情页、{sortedPosts.length} 篇深度长文及 {FAQS_DATA.length} 篇技术 FAQ 独立解决方案。
      </p>
    </header>

    <!-- Core Channels & XML Sitemaps -->
    <section class="content-wrapper" style="margin-top: 0; margin-bottom: 2rem;">
      <h2 style="font-size: 1.4rem; margin-top: 0; margin-bottom: 1.25rem; color: var(--text-heading);">
        🏛️ 核心频道与搜索引擎 XML / RSS 入口
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.85rem;">
        <a href="/" class="sitemap-box-link">🏠 2027机场榜首页 (主榜单总览)</a>
        <a href="/ranking" class="sitemap-box-link">🏆 2027年度排行榜 (35家横向对比)</a>
        <a href="/reviews" class="sitemap-box-link">💰 全品牌套餐价格与优惠码中心</a>
        <a href="/clients" class="sitemap-box-link">📱 全平台开源 Clash 客户端下载中心</a>
        <a href="/guide" class="sitemap-box-link">📘 2027机场选购与防跑路避坑指南</a>
        <a href="/faq" class="sitemap-box-link">💡 45 篇硬核 FAQ 百科知识库</a>
        <a href="/posts" class="sitemap-box-link">📝 深度评测与技术教程博客专栏</a>
        <a href="/sitemap.xml" target="_blank" class="sitemap-box-link">🤖 标准 XML Sitemap (sitemap.xml)</a>
        <a href="/sitemap-index.xml" target="_blank" class="sitemap-box-link">📑 XML 索引文件 (sitemap-index.xml)</a>
        <a href="/rss.xml" target="_blank" class="sitemap-box-link">📡 全站 RSS 实时订阅源 (rss.xml)</a>
        <a href="/robots.txt" target="_blank" class="sitemap-box-link">⚙️ 爬虫抓取协议 (robots.txt)</a>
      </div>
    </section>

    <!-- All 35 Brand Reviews -->
    <section class="content-wrapper" style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.4rem; margin-top: 0; margin-bottom: 1.25rem; color: var(--text-heading);">
        💎 全部 {AIRPORT_LIST.length} 家机场独立评测与完整套餐页 (/reviews/)
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(265px, 1fr)); gap: 0.75rem;">
        {AIRPORT_LIST.map((a) => (
          <a href={`/reviews/${a.id}`} class="sitemap-item-row">
            <span style="font-weight: 700; color: var(--text-heading);">#{a.rank} {a.name}</span>
            <span style="font-size: 0.78rem; color: #d97706; font-weight: 700;">
              {a.price} · {a.plans.length}档
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- All 5 Deep Dive Blog Posts -->
    <section class="content-wrapper" style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.4rem; margin-top: 0; margin-bottom: 1.25rem; color: var(--text-heading);">
        📚 深度评测报告与使用教程专栏 ({sortedPosts.length} 篇 /posts/)
      </h2>
      <ul style="list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem;">
        {sortedPosts.map((post) => (
          <li style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.75rem 1rem;">
            <a href={`/posts/${post.id}`} style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; color: var(--text-heading); font-weight: 600;">
              <span>[{post.data.category}] {post.data.title}</span>
              <span style="font-size: 0.8rem; color: #64748b;">📅 {post.data.pubDate}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- All 45 Standalone FAQ Pages grouped by 6 categories -->
    <section class="content-wrapper" style="margin-bottom: 0;">
      <h2 style="font-size: 1.4rem; margin-top: 0; margin-bottom: 1.25rem; color: var(--text-heading);">
        ❓ 全量 {FAQS_DATA.length} 篇独立 FAQ 解决方案索引 (/faq/)
      </h2>
      <div style="display: grid; gap: 1.75rem;">
        {FAQ_CATEGORIES.map((cat) => {
          const catFaqs = FAQS_DATA.filter((f) => f.category === cat);
          return (
            <div>
              <h3 style="font-size: 1.1rem; font-weight: 700; color: #1d4ed8; margin: 0 0 0.75rem; padding-bottom: 0.4rem; border-bottom: 1px solid #e2e8f0;">
                {cat} ({catFaqs.length} 篇)
              </h3>
              <ul style="list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 0.55rem 1.25rem;">
                {catFaqs.map((faq) => (
                  <li style="margin: 0;">
                    <a href={`/faq/${faq.id}`} style="font-size: 0.88rem; color: #334155; display: inline-flex; align-items: flex-start; gap: 0.35rem; line-height: 1.45;">
                      <span style="color: #2563eb;">•</span>
                      <span>{faq.question}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .sitemap-box-link {
    background: #f8fafc;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.7rem 1rem;
    color: var(--text-heading);
    font-weight: 600;
    font-size: 0.88rem;
    transition: all 0.15s;
  }
  .sitemap-box-link:hover {
    border-color: #93c5fd;
    background: #eff6ff;
    color: #2563eb;
  }
  .sitemap-item-row {
    background: #f8fafc;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.55rem 0.85rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.86rem;
    transition: all 0.15s;
  }
  .sitemap-item-row:hover {
    border-color: #93c5fd;
    background: #eff6ff;
  }
</style>
